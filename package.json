{
  "name": "photonify",
  "version": "5.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Photonify/Photonify.git"
  },
  "description": "Photonify is a utility to manage multipart image uploads and automatically process them with fingerprinting and storage.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "mocha",
    "coverage": "c8 mocha",
    "prettier": "prettier --write \"**/*.{ts,js,tsx,jsx,json,css,scss,md}\"",
    "prettier:check": "prettier --check \"**/*.{ts,js,tsx,jsx,json,css,scss,md}\"",
    "lint": "eslint \"**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "author": "Aaron Sood",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "^20.11.6",
    "aws-sdk-client-mock": "^4.1.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.2.0",
    "mocha": "^12.0.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.58.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "sharp": "^0.35.3"
  }
}

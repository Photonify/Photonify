{
  "name": "photonify",
  "version": "5.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Photonify/Photonify.git"
  },
  "homepage": "https://github.com/Photonify/Photonify#readme",
  "bugs": {
    "url": "https://github.com/Photonify/Photonify/issues"
  },
  "description": "Resize image buffers into multiple sizes with sharp and store them on the local filesystem or AWS S3.",
  "keywords": [
    "image",
    "resize",
    "sharp",
    "thumbnail",
    "image-processing",
    "s3",
    "aws",
    "webp",
    "avif",
    "jpeg",
    "png",
    "tiff"
  ],
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./dist/src/*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    },
    "./dist/src/*.js": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "mocha",
    "coverage": "c8 mocha",
    "prettier": "prettier --write \"**/*.{ts,js,tsx,jsx,json,css,scss,md}\"",
    "prettier:check": "prettier --check \"**/*.{ts,js,tsx,jsx,json,css,scss,md}\"",
    "lint": "eslint \"**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "author": "Aaron Sood",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "^20.11.6",
    "aws-sdk-client-mock": "^4.1.0",
    "c8": "^12.0.0",
    "chai": "^4.3.7",
    "eslint": "^10.9.1",
    "mocha": "^12.0.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "sharp": "^0.35.4"
  }
}
